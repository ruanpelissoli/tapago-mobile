# Copy this file to `.env` and adjust for your environment.
#
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the JS bundle at
# build time. Never put secrets here — everything in this file ships with the app.

# Base URL of the TaPago backend API (no trailing slash).
# Android emulator reaches the host machine at 10.0.2.2, iOS simulator at localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Google OAuth client IDs, from Google Cloud Console -> Credentials.
#
# These are public client *identifiers*, not secrets: Google requires them to be
# embedded in the app, and the OAuth flow is secured by PKCE plus the registered
# redirect URI rather than by keeping them hidden.
#
# Create one credential per platform. Whichever ID the app authenticates with
# ends up in the `aud` claim of the ID token, so it must also appear in the
# backend's GOOGLE_CLIENT_IDS list or /auth/google will reject the token.
#
# Leave every value blank to hide the Google button (see src/services/env.ts).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# "Web application" client ID. Needed for Expo Go and web, and used as the
# fallback audience when the current platform has no dedicated ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
