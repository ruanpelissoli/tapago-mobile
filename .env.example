# Copy this file to `.env` and adjust for your environment.
#
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the JS bundle at
# build time. Never put secrets here — everything in this file ships with the app.

# Base URL of the TaPago backend API (no trailing slash).
# Android emulator reaches the host machine at 10.0.2.2, iOS simulator at localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
