# Tapago API — local environment template.
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
#
#   cp .env.example .env
#
# The server reads these straight from the process environment (os.Getenv) — it
# does not parse .env itself. Export them in your shell, or use a runner such as
# `direnv` or `dotenv -- go run ./cmd/api`.

# TCP port the HTTP server listens on. Optional, defaults to 8080.
PORT=8080

# PostgreSQL connection string. REQUIRED — the server exits with a non-zero
# status if this is unset or if the initial ping fails.
# Add `?sslmode=require` for any non-local database.
DATABASE_URL=postgres://tapago:tapago@localhost:5432/tapago?sslmode=disable

# Secret used to sign and verify JWT access tokens. Not yet consumed — the auth
# endpoints land in a later task — but provision it now so environments are
# ready. Use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-in-every-environment
